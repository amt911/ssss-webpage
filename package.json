{
  "name": "ssss-webpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Single-file, fully offline Shamir Secret Sharing page.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node build.mjs && playwright test",
    "test:mutation": "stryker run",
    "test:all": "pnpm run type-check && pnpm run test:cov && pnpm run test:e2e",
    "pr-check": "pnpm run type-check && pnpm run test:cov"
  },
  "dependencies": {
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
